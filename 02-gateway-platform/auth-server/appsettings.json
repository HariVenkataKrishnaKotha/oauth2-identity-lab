{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=AuthServerDb;User Id=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=True;",
    "DataProtection": "Server=localhost;Database=AuthServerDataProtection;User Id=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=True;"
  },
  "OpenIddict": {
    "Issuer": "https://auth.local" // change to your real public issuer (gateway URL) later
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
