{
  "Gateway": {
    "Issuer": "https://auth.local", // MUST match AuthServer Issuer
    "ExpectedAudiences": [ "resource-api" ], // resources() set by AuthServer
    "DiscoveryUrl": "https://auth.local/.well-known/openid-configuration",
    "JwksUri": "https://auth.local/.well-known/jwks.json",
    //"Introspection": {
    //  "Endpoint": "https://auth.local/connect/introspect",
    //  "ClientId": "yarp-gateway",
    //  "ClientSecret": "dev-only-change-me"
    //},
    // NEW: choose how the gateway authenticates access tokens
    "ValidationMode": "PreferIntrospection", // PreferIntrospection | JwtFirst | IntrospectionOnly
    "TokenClockSkewSeconds": 60
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "JwksCacheKey": "jwks:auth.local",
    // Short TTLs because the AuthServer key can change on restart
    "JwksCacheSeconds": 60,
    "IntrospectionCachePrefix": "introspect:"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "api": {
        "ClusterId": "resourceapi",
        "Match": { "Path": "/api/{**catch-all}" },
        "AuthorizationPolicy": "ApiDefault",
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "badge-approve": {
        "ClusterId": "resourceapi",
        "Match": { "Path": "/api/onboarding/{id}/badge-approval" },
        "AuthorizationPolicy": "ManagerWrite",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "d1": { "Address": "https://localhost:5018/" } },
        "HttpRequest": {
          "ActivityTimeout": "00:00:20" // overall upstream timeout
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "ReactivationPeriod": "00:05:00"
          },
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Metadata": {
          "ClientCertPath": "certs/gateway-auth-client.pfx",
          "ClientCertPassword": "dev-only-change-me"
        }
      },
      "resourceapi": {
        "Destinations": { "d1": { "Address": "https://localhost:5173/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:20" },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "ReactivationPeriod": "00:05:00"
          },
          "Active": {
            "Enabled": true,
            "Interval": "00:00:20",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Metadata": {
          "ClientCertPath": "certs/gateway-resource-client.pfx",
          "ClientCertPassword": "dev-only-change-me"
        }
      }
    }
  },
  "RateLimiting": {
    "AuthWindowSeconds": 60,
    "AuthMax": 60,
    "IdentifyWindowSeconds": 300,
    "IdentifyMax": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
