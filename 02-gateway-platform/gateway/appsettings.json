{
  "Gateway": {
    "Issuer": "https://localhost:5000/",
    "ExpectedAudiences": [ "resource-api" ],
    "DiscoveryUrl": "https://localhost:5000/.well-known/openid-configuration",
    "JwksUri": "https://localhost:5000/.well-known/jwks",
    "Introspection": {
      "Endpoint": "https://localhost:5018/connect/introspect",
      "ClientId": "yarp-gateway",
      "ClientSecret": "dev-only-change-me"
    },
    "ValidationMode": "JwtOnly",
    "TokenClockSkewSeconds": 60
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "JwksCacheKey": "jwks:auth.local",
    "JwksCacheSeconds": 60,
    "IntrospectionCachePrefix": "introspect:"
  },
  "ReverseProxy": {
    "Routes": {
      "connect-authorize": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/connect/authorize"
        }
      },
      "connect-token": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/connect/token"
        }
      },
      "connect-introspect": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/connect/introspect"
        }
      },
      "connect-userinfo": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/connect/userinfo"
        }
      },
      "account-login": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/Account/Login"
        }
      },
      "account-enroll": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/Account/Enroll"
        }
      },
      "well-known": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/.well-known/{**remainder}"
        }
      },
      "onboarding-identify": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/onboarding/identify"
        }
      },
      "onboarding-magic": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/onboarding/magic"
        }
      },
      "resourceapi-onboarding": {
        "ClusterId": "resourceapi",
        "Match": {
          "Path": "/onboarding/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:5018/"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "resourceapi": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:5173/"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  },
  "RateLimiting": {
    "AuthWindowSeconds": 60,
    "AuthMax": 60,
    "IdentifyWindowSeconds": 300,
    "IdentifyMax": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}